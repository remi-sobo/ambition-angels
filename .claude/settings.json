{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production*)",
      "Read(**/.env.development*)",
      "Read(**/.env.test*)",

      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(supabase db reset:*)",
      "Bash(supabase db push:*)",
      "Bash(npx supabase db reset:*)",
      "Bash(npx supabase db push:*)",

      "mcp__Supabase__create_project",
      "mcp__Supabase__pause_project",
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__deploy_edge_function",
      "mcp__Supabase__create_edge_function_secret",

      "mcp__Vercel__buy_domain",
      "mcp__Vercel__buy_domains",
      "mcp__Vercel__buy_single_domain",
      "mcp__Vercel__get_project_env",
      "mcp__Vercel__filter_project_envs",
      "mcp__Vercel__create_project_env",
      "mcp__Vercel__edit_project_env",
      "mcp__Vercel__add_project_domain",
      "mcp__Vercel__create_or_transfer_domain",
      "mcp__Vercel__replace_domain_dns_records",
      "mcp__Vercel__create_record",
      "mcp__Vercel__update_record"
    ],
    "ask": [
      "mcp__Gmail__send_message",
      "mcp__Gmail__forward",
      "mcp__Gmail__reply",
      "mcp__Slack__slack_send_message",
      "mcp__Google_Drive__share_file",
      "mcp__Read_AI__share_meeting_report",
      "mcp__github__merge_pull_request",
      "mcp__github__actions_run_trigger",
      "mcp__Supabase__execute_sql",
      "mcp__Slack__slack_schedule_message",
      "mcp__Gmail__trash_message",
      "mcp__Gmail__trash_thread",
      "mcp__Google_Calendar__create_event",
      "mcp__Google_Calendar__update_event",
      "mcp__Google_Calendar__delete_event",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__enable_pr_auto_merge",
      "mcp__HubSpot__manage_crm_objects",
      "mcp__Read_AI__share_folder"
    ]
  }
}
