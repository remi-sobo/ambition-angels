# Ambition Angels — environment variables
# Copy to `.env.local` (gitignored) and fill in. Production values live in Vercel.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin auth ──────────────────────────────────────────────────────────────
# Single shared password (legacy). PR 2 adds per-user passwords; this one
# continues to work as a fallback during the transition.
ADMIN_PASSWORD=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Stripe (donations) ──────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Anthropic (career-quiz API route) ───────────────────────────────────────
ANTHROPIC_API_KEY=
