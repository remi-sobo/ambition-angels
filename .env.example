# Ambition Angels — environment variables
# Copy to `.env.local` (gitignored) and fill in. Production values live in Vercel.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin auth ──────────────────────────────────────────────────────────────
# Per-user passwords. The login route matches the submitted password
# against these and sets an `admin_user` cookie identifying who's signed in.
ADMIN_PASSWORD_REMI=
ADMIN_PASSWORD_SHANNON=

# Legacy shared password — kept as a fallback during the transition.
# Anyone matching this gets logged in as Remi by default.
ADMIN_PASSWORD=

# ── Demo Day lookbook gate ──────────────────────────────────────────────────
# Shared password protecting the public /demoday lookbook. Anyone with this
# password (or a logged-in admin) can view it. If unset, the lookbook is
# locked to admins only (fails closed).
DEMODAY_PASSWORD=

# ── Strategy Room gate ──────────────────────────────────────────────────────
# Shared team password protecting the internal /strategy funder-framing
# reference. Anyone with this password (or a logged-in admin) can view it.
# If unset, the room is locked to admins only (fails closed). To change it,
# update this value in Vercel (Project → Settings → Environment Variables)
# and redeploy — anyone holding the old password is signed out at that point.
STRATEGY_ROOM_PASSWORD=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
# Where YGB Creators Camp registration notifications are sent.
# Optional — defaults to remi@ambitionangels.org.
YGB_NOTIFY_EMAIL=

# ── Stripe (donations) ──────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Anthropic (career-quiz API + funder research agent) ────────────────────
# Create a key at https://console.anthropic.com. The funder research agent
# (PR 10) uses Opus with prompt caching and the built-in web search tool.
ANTHROPIC_API_KEY=

# ── Cron (Vercel) ────────────────────────────────────────────────────────────
# Bearer token Vercel sends with cron-triggered requests. Must match the
# value sent on Authorization: Bearer <secret>. Generate any random string.
CRON_SECRET=

# ── Task ingest (POST /api/ingest/tasks) ─────────────────────────────────────
# Bearer token for the external task-ingest endpoint (e.g. Shannon's Claude
# Cowork morning run seeding her to-dos). Generate a long random string and
# give it to the calling agent. Leave blank to disable the endpoint (503).
TASK_INGEST_SECRET=

# ── Google (Calendar + Gmail, for /meet) ────────────────────────────────────
# OAuth2 user delegation. Create an OAuth client in Google Cloud Console
# (type: Web application). For the in-app calendar connect flow
# (Settings → Connect Google Calendar), register the callback on the ADMIN
# app origin (APP_ORIGIN, or the request host when unset) as an authorized
# redirect URI on this client — e.g.
#   https://app.bloomos.org/api/admin/agenda/connect-google/callback
#   http://localhost:3000/api/admin/agenda/connect-google/callback   (dev)
# NOT the marketing origin (NEXT_PUBLIC_SITE_URL): the callback + its CSRF
# state cookie live on the admin host, so a marketing-origin redirect_uri
# both fails Google's redirect_uri_mismatch check and loses the cookie.
# Users then pick their own account/calendars via Google's account chooser.
# GOOGLE_REFRESH_TOKEN remains only for the org booking account used by /meet
# and Gmail sending (lib/google/auth.ts): run a consent flow once as the org
# account with scopes `calendar` + `gmail.send`, capture the refresh_token,
# and store it here. The googleapis library refreshes the access token
# automatically on each API call.
# NOTE: the fundraising email logging (Constituent 360 / Gmail sync) also needs
# the `gmail.readonly` scope on this same token. Re-run the consent flow with
# `gmail.readonly` added and replace GOOGLE_REFRESH_TOKEN; until then the Gmail
# sync runs but logs zero (the read calls 403).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional. Calendar operations default to the authenticated user's primary
# calendar (remi@ambitionangels.org). Set this to override.
GOOGLE_CALENDAR_ID=

# ── Provider token encryption (BloomOS Agenda Phase 2) ──────────────────────
# AES-256-GCM key for secrets stored in connections.*_enc (app-layer; see
# docs/bloomos/04-security-compliance.md). Generate with: openssl rand -base64 32
# Required for the Settings calendar connect flow, which stores each user's
# Google Calendar refresh token in the encrypted connections store.
BLOOMOS_TOKEN_ENC_KEY=

# ── Zoom (static personal room for video bookings) ──────────────────────────
# Your Zoom Personal Meeting Room URL. Every video /meet booking uses this
# URL; the URL is snapshotted onto each booking row at creation time, so
# changing this later does not rewrite existing bookings.
ZOOM_URL=
# Optional, only set if your PMR requires a passcode that isn't embedded
# in the URL. Surfaced in emails for the rare client that needs it.
ZOOM_PASSCODE=

# ── HubSpot (admin → HubSpot read-only sync) ────────────────────────────────
# Private App token. Required scopes: crm.objects.contacts.read,
# crm.objects.companies.read, crm.objects.deals.read, plus the engagements
# scopes (emails/calls/meetings/notes/tasks read).
HUBSPOT_ACCESS_TOKEN=

# Portal ID, used only to construct deep-links to HubSpot from the admin
# (e.g. https://app.hubspot.com/contacts/<id>/contact/<contactId>). No API
# access. If unset, "View in HubSpot" links are hidden.
HUBSPOT_PORTAL_ID=

# ── Finance Model sheet (Apps Script Web App proxy, read-only) ──────────────
# Powers /admin/finance/model. The org blocks service-account keys, so the
# sheet itself hosts a bound Apps Script deployed as a Web App that reads
# four specific cells and returns them as JSON, gated by a shared secret.
# Salaries on the same tab are never accessed by the script — the cell
# mapping in scripts/finance-model-webhook.gs explicitly enumerates only
# the four KPI cells.
#
# Setup:
#   1. Open the model sheet → Extensions → Apps Script.
#   2. Paste the contents of scripts/finance-model-webhook.gs into Code.gs.
#   3. Update CELLS and TAB_NAME at the top of that file to match your sheet.
#   4. Project Settings → Script Properties → add SHARED_SECRET = (random
#      32+ char string; same value you'll set as FINANCE_MODEL_WEBHOOK_TOKEN
#      below).
#   5. Deploy → New deployment → type: Web app. Execute as: Me. Who has
#      access: Anyone with the link. Deploy. Copy the /macros/s/.../exec URL.
#   6. Paste the URL into FINANCE_MODEL_WEBHOOK_URL below.
FINANCE_MODEL_WEBHOOK_URL=
FINANCE_MODEL_WEBHOOK_TOKEN=

# Spreadsheet ID — the long alphanumeric string in the sheet URL between
# /d/ and /edit. Used ONLY to build the "View full model ↗" deep-link on
# /admin/finance/model; not a credential.
FINANCE_SHEET_ID=
