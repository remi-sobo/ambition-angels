# Ambition Angels — environment variables
# Copy to `.env.local` (gitignored) and fill in. Production values live in Vercel.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin auth ──────────────────────────────────────────────────────────────
# Per-user passwords. The login route matches the submitted password
# against these and sets an `admin_user` cookie identifying who's signed in.
ADMIN_PASSWORD_REMI=
ADMIN_PASSWORD_SHANNON=

# Legacy shared password — kept as a fallback during the transition.
# Anyone matching this gets logged in as Remi by default.
ADMIN_PASSWORD=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Stripe (donations) ──────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Anthropic (career-quiz API + funder research agent) ────────────────────
# Create a key at https://console.anthropic.com. The funder research agent
# (PR 10) uses Opus with prompt caching and the built-in web search tool.
ANTHROPIC_API_KEY=

# ── Cron (Vercel) ────────────────────────────────────────────────────────────
# Bearer token Vercel sends with cron-triggered requests. Must match the
# value sent on Authorization: Bearer <secret>. Generate any random string.
CRON_SECRET=

# ── Google (Calendar + Gmail, for /meet) ────────────────────────────────────
# OAuth2 user delegation. Create an OAuth client in Google Cloud Console
# (type: Web application), run the consent flow once as remi@ambitionangels.org
# with scopes `calendar` + `gmail.send`, capture the refresh_token from the
# token response, and store it here. The googleapis library refreshes the
# access token automatically on each API call.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional. Calendar operations default to the authenticated user's primary
# calendar (remi@ambitionangels.org). Set this to override.
GOOGLE_CALENDAR_ID=

# ── Zoom (static personal room for video bookings) ──────────────────────────
# Your Zoom Personal Meeting Room URL. Every video /meet booking uses this
# URL; the URL is snapshotted onto each booking row at creation time, so
# changing this later does not rewrite existing bookings.
ZOOM_URL=
# Optional, only set if your PMR requires a passcode that isn't embedded
# in the URL. Surfaced in emails for the rare client that needs it.
ZOOM_PASSCODE=

# ── HubSpot (admin → HubSpot read-only sync) ────────────────────────────────
# Private App token. Required scopes: crm.objects.contacts.read,
# crm.objects.companies.read, crm.objects.deals.read, plus the engagements
# scopes (emails/calls/meetings/notes/tasks read).
HUBSPOT_ACCESS_TOKEN=

# Portal ID, used only to construct deep-links to HubSpot from the admin
# (e.g. https://app.hubspot.com/contacts/<id>/contact/<contactId>). No API
# access. If unset, "View in HubSpot" links are hidden.
HUBSPOT_PORTAL_ID=
